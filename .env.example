# ----------------------------------------------------------------------------
# Hollywood Whitening — frontend environment (same variables as allwhitelaser-next)
# TEMPLATE — copy to .env.local and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# ----------------------------------------------------------------------------

# --- WordPress backend ---
# WordPress origin the app reads data from (Instagram feed: /wp-json/aw3/v1/instagram; the blog
# uses WP_API_URL below when set), and where
# src/proxy.ts sends product links carrying ?poa= / ?rent_poa= / ?add-to-cart= (WooCommerce checkout).
# Change to the WordPress host (e.g. https://business.hollywoodwhitening.com) once Next serves www.
# Until that endpoint exists on Hollywood's WP, the feed uses src/content/instagram.json.
NEXT_PUBLIC_WP_URL=https://www.hollywoodwhitening.com
# Blog API host (server-only): where hollywood-wp's custom/blog-api.php (aw3/v1 blogs|post|
# category) is deployed. Called as /?rest_route=/aw3/v1/… because /wp-json/<route> answers
# a Cloudflare 502 on shop. Unset → NEXT_PUBLIC_WP_URL.
WP_API_URL=https://shop.hollywoodwhitening.com
# Public media base for Instagram images cached by the WP plugin (defaults to <WP>/wp-content/uploads)
# WP_PUBLIC_MEDIA_URL=https://www.hollywoodwhitening.com/wp-content/uploads
# Secret sent as X-AWL-Internal on server-side WordPress requests, so the WP host can exempt this
# app from rate limiting / firewall rules (src/lib/wp-headers.ts). Optional.
# WP_INTERNAL_KEY=
# Shared secret sent as the X-HW-Origin-Token header on every server request to WP.
# Cloudflare on shop.hollywoodwhitening.com challenges Vercel's servers ("Just a moment…",
# 403); a Cloudflare custom rule that skips the challenge when this header matches lets
# only this app through. Any long random string — the same value goes in that rule.
# WP_ORIGIN_TOKEN=
# nginx basic-auth gate in front of a staging WP (leave unset in production)
# WP_BASIC_AUTH_USER=
# WP_BASIC_AUTH_PASS=

# --- Location Finder (/location-finder/) ---
# Store feed (server-only): the aw3/v1/providers endpoint from hollywood-wp's
# theme-customisations-master/custom/providers-api.php.
# ?rest_route= form because /wp-json/<route> paths answer 502 on shop.hollywoodwhitening.com.
# Unset in development → three sample stores; unset in production → the list shows an error.
WP_PROVIDERS_URL=https://shop.hollywoodwhitening.com/?rest_route=/aw3/v1/providers
# Google Maps JS API key. Read on the server and passed to the locator, so no NEXT_PUBLIC_
# prefix — but it still ends up in the page for the browser's Maps script, so restrict it
# to the site's domains. Needs Maps JavaScript, Places and Geocoding APIs. Without it the map
# is hidden; "Use my position" and "View all stores" still work.
# GOOGLE_MAPS_API_KEY=

# --- Gravity Forms (server-only) — "Get in touch" enquiry form (form 3) ---
# /api/enquiry posts to <GF_API_URL>/?rest_route=/gf/v2/forms/3/submissions
# (?rest_route= because /wp-json/<route> paths answer 502 on shop.hollywoodwhitening.com).
# The GF REST API must be enabled on the backend WP (Forms → Settings → REST API);
# until it is, submissions fail and the form tells visitors to call instead.
GF_API_URL=https://shop.hollywoodwhitening.com
# Optional — /submissions is public in GF. When set, requests are OAuth-signed.
# GF_CONSUMER_KEY=
# GF_CONSUMER_SECRET=
# reCAPTCHA v2 site key (public). Defaults to the backend WP's GF key — add localhost
# to its allowed domains in the reCAPTCHA admin to test locally.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
