# ----------------------------------------------------------------------------
# Hollywood Whitening — frontend environment (same variables as allwhitelaser-next)
# TEMPLATE — copy to .env.local and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# ----------------------------------------------------------------------------

# --- WordPress backend ---
# WordPress origin the app reads data from (Instagram feed: /wp-json/aw3/v1/instagram), and where
# src/proxy.ts sends product links carrying ?poa= / ?rent_poa= / ?add-to-cart= (WooCommerce checkout).
# Change to the WordPress host (e.g. https://business.hollywoodwhitening.com) once Next serves www.
# Until that endpoint exists on Hollywood's WP, the feed uses src/content/instagram.json.
NEXT_PUBLIC_WP_URL=https://www.hollywoodwhitening.com
# Public media base for Instagram images cached by the WP plugin (defaults to <WP>/wp-content/uploads)
# WP_PUBLIC_MEDIA_URL=https://www.hollywoodwhitening.com/wp-content/uploads
# nginx basic-auth gate in front of a staging WP (leave unset in production)
# WP_BASIC_AUTH_USER=
# WP_BASIC_AUTH_PASS=

# --- Gravity Forms (server-only) — "Get in touch" enquiry form (form 3) ---
# /api/enquiry posts to <GF_API_URL>/?rest_route=/gf/v2/forms/3/submissions
# (?rest_route= because /wp-json/<route> paths answer 502 on shop.hollywoodwhitening.com).
# The GF REST API must be enabled on the backend WP (Forms → Settings → REST API);
# until it is, submissions fail and the form tells visitors to call instead.
GF_API_URL=https://shop.hollywoodwhitening.com
# Optional — /submissions is public in GF. When set, requests are OAuth-signed.
# GF_CONSUMER_KEY=
# GF_CONSUMER_SECRET=
# reCAPTCHA v2 site key (public). Defaults to the backend WP's GF key — add localhost
# to its allowed domains in the reCAPTCHA admin to test locally.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
